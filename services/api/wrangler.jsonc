// FreeFORM's web service. Deploy from this folder: npx wrangler@4.153.0 deploy (see README.md here).
{
  "name": "freeform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "routes": [{ "pattern": "api.freeformdrill.org", "custom_domain": true }],
  // Email Routing's free sending: only to addresses verified in Email Routing (which one is the FEEDBACK_TO secret).
  "send_email": [{ "name": "EMAIL" }],
  // Feedback: 3 messages a minute from one visitor. Publishing: 6 a minute.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "UPLOADS", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ],
  // The published (encrypted) show files. Workers KV: no card needed; 1 GB and 25 MB a file on the free plan.
  "kv_namespaces": [{ "binding": "SHOWS" }],
  // Every day at 07:17 UTC: delete shows nobody has opened or updated for a year.
  "triggers": { "crons": ["17 7 * * *"] },
  "observability": { "enabled": true }
}
